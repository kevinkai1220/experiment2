{
  "data": "data/fish_cancer_raw.h5ad",
  "coordinates": "data/fish_coordinates.csv",
  "synthetic": false,
  "type_key": "celltype2",
  "perturbation_key": "perturbation",
  "tissue_key": null,
  "control_label": "Control",
  "assume_single_tissue": true,
  "transform": "log1p",
  "output": "results/fish_joint",
  "device": "cuda",
  "seed": 42,
  "epochs": 50,
  "batch_size": 16,
  "hidden": 64,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "validation_fraction": 0.2,
  "neighbors": 16,
  "graph_mode": "all",
  "distance_mode": "fixed",
  "sender_chunk_size": 32,
  "checkpoint_senders": true,
  "radius": null,
  "distance_power": 1.0,
  "distance_epsilon": 0.001,
  "n_modules": 20,
  "random_ratio": 0.2,
  "high_min": 0.4,
  "high_max": 0.5,
  "module_ratio": 0.4,
  "sender_ratio": 0.2,
  "mixture": [
    0.5,
    0.25,
    0.25
  ],
  "validation_ratios": [
    0.2,
    0.4,
    0.5,
    0.6
  ],
  "lambda_msg": 0.05,
  "lambda_adv": 0.01,
  "huber_delta": 1.0,
  "shuffle_repeats": 3,
  "min_relative_gain": 0.01,
  "delta_rms_threshold": 0.001,
  "absolute_tolerance": 0.0001,
  "cpu_threads": 2
}
